#!/usr/bin/env python
# -*- coding: UTF-8 -*-
"""
This code is all in one file, and supports Python 2, in order that it can be wrapped conveniently
as a MacOS application bundle (e.g. using https://github.com/sveinbjornt/Platypus).
"""
from __future__ import print_function
import datetime
import os
import subprocess
import sys

try:
    from urllib.parse import urlparse
except ImportError:
    # Python 2
    from urlparse import urlparse

LOGFILE        = "/tmp/open-in-editor.log"
OPEN_IN_EDITOR = os.getenv("OPEN_IN_EDITOR")
EDITOR         = os.getenv("EDITOR")

def main():
    try:
        editor = BaseEditor.infer_from_environment_variables()
        (url,) = sys.argv[1:]
        path, line, column = parse_url(url)
        log_info("path=%s line=%s column=%s" % (path, line, column))
        editor.visit_file(path, line or 1, column or 1)
    except Exception:
        from traceback import format_exc

        log_error(format_exc())
        sys.exit(1)


def parse_url(url):  # type: (str) -> (str, Optional[int], Optional[int]):
    """
    Parse a file-like URL into path, line, and column.

    >>> parse_url("file:///a/b/myfile.txt")
    ('/a/b/myfile.txt', None, None)

    >>> parse_url("file-line-column:///a/b/myfile.txt")
    ('/a/b/myfile.txt', None, None)

    >>> parse_url("file:///a/b/myfile.txt:7")
    ('/a/b/myfile.txt', 7, None)

    >>> parse_url("file:///a/b/myfile.txt:7:77")
    ('/a/b/myfile.txt', 7, 77)

    >>> parse_url("file://localhost/a/b/myfile.txt:7:77")
    ('/a/b/myfile.txt', 7, 77)
    """
    path, _, line_and_column = urlparse(url).path.partition(":")
    line, _, column = line_and_column.partition(":")
    try:
        line = int(line)
    except ValueError:
        line = None
    try:
        column = int(column)
    except ValueError:
        column = None
    return path, line, column


def log(line):
    time = datetime.datetime.now().isoformat(" ").split(".")[0]
    with open(LOGFILE, "a") as fp:
        print(time, file=fp)
        print(line, file=fp)
        print("\n", file=fp)
        fp.flush()

log_info = log
log_error = log

class BaseEditor(object):
    """
    Abstract base class for editors.
    """

    @classmethod
    def infer_editor_from_path(cls, path):
        """
        Infer the editor type and its executable path heuristically
        """
        # 'Apps/VS Code - In.app/app/bin/code -arg'
        # ↓ up to last /     = '/Apps/VS Code - In.app/app/bin'
        path_head, path_tail = os.path.split(path)
        # after the last / ↑ = 'code -arg'
        path_bin = path_tail.split(' -')[0].strip() # remove ' -args' = 'code'
        path_head = path_head + os.sep if path_head else path_head # add / back if it existed
        executable_path = path_head + path_bin

        editors = [Neovim]

        inferred_editor = next((ed for ed in editors if path_bin == ed.executable_name), None)
        if inferred_editor is None:
            log_error(
                "ERROR: failed to infer your editor. "
                "The values of the relevant environment variables are: "
                "OPEN_IN_EDITOR=%s and EDITOR=%s. "
                "I was expecting one of these to contain one of the following substrings: "
                "%s."
                % (OPEN_IN_EDITOR, EDITOR, ", ".join(ed.executable_name for ed in editors))
            )
            sys.exit(1)
        return inferred_editor()

    @classmethod
    def infer_from_environment_variables(cls):
        """
        Infer the editor type and its executable path heuristically from environment variables.
        """
        executable_path_with_arguments_maybe = "nvim"

        return cls.infer_editor_from_path(executable_path_with_arguments_maybe)

    def __init__(self, executable):
        self.executable = executable

    def visit_file(self, path, line, column):
        raise NotImplementedError()

class KittyController:
    """
    Simple class to interact with Kitty's remote control protocol using socket files
    """
    def __init__(self, kitty_executable):
        self.kitty_executable = kitty_executable
        self.socket_path = self._get_kitty_socket()

    def _get_kitty_socket(self):
        """
        Get the Kitty socket path by looking for sockets in /tmp with the format /tmp/mykitty-PID
        """
        # Look for sockets in /tmp with the format /tmp/mykitty-PID
        try:
            import glob
            kitty_sockets = glob.glob('/tmp/mykitty-*')
            if kitty_sockets:
                # Get the first available socket
                socket_path = kitty_sockets[0]
                log_info(f"Found Kitty socket: {socket_path}")

                # Make sure it has the unix: prefix
                if not socket_path.startswith('unix:'):
                    socket_path = f'unix:{socket_path}'

                return socket_path
        except Exception as e:
            log_error(f"Error finding Kitty socket: {str(e)}")

        log_info("No Kitty socket found")
        return None

    def is_kitty_running(self):
        """
        Check if Kitty is running by checking if a socket path was found
        """
        return self.socket_path is not None

    def launch_tab(self, command, tab_title=None):
        """
        Launch a new tab in an existing Kitty window with the specified command
        """
        if not self.socket_path:
            return False

        try:
            cmd = [self.kitty_executable, '@', '--to', self.socket_path, 'launch', '--type=tab']
            if tab_title:
                cmd.extend(['--tab-title', tab_title])
            cmd.append('--')
            cmd.extend(command)

            log_info(f"Launching new tab with command: {' '.join(cmd)}")

            subprocess.run(cmd, check=True)
            return True
        except subprocess.SubprocessError as e:
            log_error(f"Error launching new tab: {str(e)}")
            return False

class Neovim(BaseEditor):
    executable_name = "nvim"

    def __init__(self):
        nvim_paths = [
            "/etc/profiles/per-user/medmison/bin/nvim",
        ]

        for nvim_path in nvim_paths:
            if os.path.exists(nvim_path) and os.access(nvim_path, os.X_OK):
                self.executable = nvim_path
                return

        raise Exception(f"Unable to find Neovim in any of {''.join(nvim_paths)}")

    def visit_file(self, path, line, column):
        # Build nvim command with line and column arguments
        nvim_args = ["+%s" % str(line)]
        if column > 1:
            nvim_args.extend(["-c", "normal %sl" % str(column - 1)])
        nvim_args.append(path)

        # Find kitty executable
        kitty_paths = [
            "/etc/profiles/per-user/medmison/bin/kitty"
        ]

        kitty_executable = None
        for kitty_path in kitty_paths:
            if os.path.exists(kitty_path) and os.access(kitty_path, os.X_OK):
                kitty_executable = kitty_path
                break

        if not kitty_executable:
            raise Exception(f"Unable to find kitty executable at any of {''.join(kitty_paths)}")

        # Initialize Kitty controller
        kitty = KittyController(kitty_executable)

        # Get the filename for the tab title
        filename = os.path.basename(path)

        # Check if KITTY_LISTEN_ON is set (indicating a running Kitty instance)
        if kitty.is_kitty_running():
            # Launch a new tab with Neovim
            cmd = [self.executable] + nvim_args
            if kitty.launch_tab(cmd, tab_title=filename):
                log_info(f"Successfully launched new tab with {filename}")
                return
            else:
                log_info("Failed to launch new tab, falling back to new window")
        else:
            log_info("No kitty socket found, launching new window")

        # If KITTY_LISTEN_ON is not set or we couldn't use it, launch a new Kitty window
        cmd = [kitty_executable, self.executable] + nvim_args
        log_info(f"Launching new Kitty with command: {cmd}")

        process = subprocess.Popen(cmd)
        log_info(f"Kitty with nvim launched successfully (PID: {process.pid})")

if __name__ == "__main__":
    main()
